{
  "uid": "cadenza-analytics",
  "title": "Cadenza | Analytics",
  "tags": [
    "cadenza",
    "backend",
    "feature"
  ],
  "schemaVersion": 39,
  "version": 3,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Metrics source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "cadenza-prometheus"
        }
      },
      {
        "name": "route",
        "label": "Operation route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(sort_desc(sum by (route) (increase(cadenza_http_requests_total{job=\"cadenza-backend\",route=~\"/analytics(/.*)?|/events(/.*)?\",status!=\"cancelled\"}[$__range]))))",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/route=\"([^\"]+)\"/",
        "sort": 0,
        "description": "Routes in this feature, busiest first over the selected time range."
      }
    ]
  },
  "panels": [
    {
      "id": 18,
      "type": "stat",
      "title": "Calls (range)",
      "description": "Estimated completed invocations over the selected dashboard time range; includes error responses and excludes cancelled requests, health checks and /test. Prometheus extrapolates scraped counters, so small counts can be approximate.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cadenza_http_requests_total{job=\"cadenza-backend\",route=~\"$route\",route=~\"/analytics(/.*)?|/events(/.*)?\",status!=\"cancelled\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "p50 latency",
      "description": "Estimated percentile for the selected routes over the selected dashboard time range. Time until response headers. Sparse traffic yields noisy or empty estimates.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(cadenza_http_request_duration_seconds_bucket{job=\"cadenza-backend\",route=~\"$route\",route=~\"/analytics(/.*)?|/events(/.*)?\",status!=\"cancelled\"}[$__range])))",
          "legendFormat": "{{method}} {{route}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 latency",
      "description": "Estimated percentile for the selected routes over the selected dashboard time range. Time until response headers. Sparse traffic yields noisy or empty estimates.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(cadenza_http_request_duration_seconds_bucket{job=\"cadenza-backend\",route=~\"$route\",route=~\"/analytics(/.*)?|/events(/.*)?\",status!=\"cancelled\"}[$__range])))",
          "legendFormat": "{{method}} {{route}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p99 latency",
      "description": "Estimated percentile for the selected routes over the selected dashboard time range. Time until response headers. Sparse traffic yields noisy or empty estimates.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (increase(cadenza_http_request_duration_seconds_bucket{job=\"cadenza-backend\",route=~\"$route\",route=~\"/analytics(/.*)?|/events(/.*)?\",status!=\"cancelled\"}[$__range])))",
          "legendFormat": "{{method}} {{route}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
