      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, method, route) (rate(cadenza_http_request_duration_seconds_bucket{job=\"cadenza-backend\",route=~\"$route\",route=~\"/analytics(/.*)?|/events(/.*)?\",status!=\"cancelled\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
