      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 30,
      "title": "Call volume over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(method,route)(increase(cadenza_http_requests_total{job=\"cadenza-backend\",route=~\"$route\",route!~\"/health/.*|/test\",route=~\"/analytics(/.*)?|/events(/.*)?\",status!=\"cancelled\"}[$__interval]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{method}} {{route}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "calls"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Estimated completed calls per non-overlapping time bucket, stacked by operation. Minimum bucket: 1 minute; bucket size grows with the time range. Includes error responses. Scrape-based estimates can be fractional.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 31,
      "title": "Failed responses and cancellations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(status)(increase(cadenza_http_requests_total{job=\"cadenza-backend\",route=~\"$route\",route!~\"/health/.*|/test\",route=~\"/analytics(/.*)?|/events(/.*)?\",status=~\"4..|5..|cancelled\"}[$__interval]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{status}}",
          "interval": "1m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal",
              "group": "errors"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Estimated counts per bucket. 4xx includes authentication failures and rate limits; 5xx indicates server/provider failures. Missing series means no recorded observations.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p50 by operation",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 7
