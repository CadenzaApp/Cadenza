    {
      "id": 40,
      "type": "barchart",
      "title": "Runtime distribution - $operation",
      "description": "Calls in each non-overlapping runtime bucket over the selected range, including error responses. Prometheus cumulative buckets are converted to per-bucket counts before rendering. Fine bucket history begins at metrics schema 2; older schema data is excluded. Unequal-width buckets use equal-width bars: height is calls, not probability density. Everything above 10 seconds is combined into 10+ s. Counts are scrape-based estimates; sparse/new series can undercount. Timings end at response headers.",
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "repeat": "operation",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(le)(label_join(increase(cadenza_http_request_duration_seconds_bucket{histogram_schema=\"2\",le!~\"(20|30|40|50|60)([.]0)?\",job=\"cadenza-backend\",route=~\"$route\",route=~\"/tags(/.*)?|/songs/(default-tags|local-tags|activity-tags)(/.*)?\",status!=\"cancelled\"}[$__range]),\"operation\",\" \",\"method\",\"route\") and on(operation) label_replace(vector(1),\"operation\",\"${operation:raw}\",\"\",\"\"))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "instant": true,
          "range": false
        }
