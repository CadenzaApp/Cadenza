    {
      "id": 19,
      "type": "table",
      "title": "p50 operations (by calls)",
      "description": "Busiest completed operations first. Calls and runtime percentile cover the selected dashboard range. Counts are estimates from scraped counters; includes error responses, excludes cancellations. Blank latency means insufficient observations.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(sum by (operation) (label_join(increase(cadenza_http_requests_total{job=\"cadenza-backend\",route=~\"$route\",route=~\"/tags(/.*)?|/songs/(default-tags|local-tags|activity-tags)(/.*)?\",status!=\"cancelled\"}[$__range]),\"operation\",\" \",\"method\",\"route\")))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5,sum by(le,operation)(label_join(increase(cadenza_http_request_duration_seconds_bucket{histogram_schema=\"2\",job=\"cadenza-backend\",route=~\"$route\",route=~\"/tags(/.*)?|/songs/(default-tags|local-tags|activity-tags)(/.*)?\",status!=\"cancelled\"}[$__range]),\"operation\",\" \",\"method\",\"route\")))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "-",
          "custom": {
            "minWidth": 50
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Calls"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 68
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.width",
                "value": 82
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Calls",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "operation": "Operation",
              "Value #A": "Calls",
              "Value #B": "p50"
            },
            "indexByName": {
              "operation": 0,
              "Value #A": 1,
              "Value #B": 2
            }
          }
        }
      ]
    },
