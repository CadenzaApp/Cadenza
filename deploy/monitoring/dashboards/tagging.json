    {
      "id": 11,
      "type": "stat",
      "title": "Provider calls in current budget window",
      "description": "Process-local 24-hour window, not a calendar day. Resets on app restart/replacement. This counts attempts, not dollars. Server-wide process counters/limits, independent of the route selector. Counters reset on restart.",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cadenza_provider_window_calls{job=\"cadenza-backend\"})",
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
