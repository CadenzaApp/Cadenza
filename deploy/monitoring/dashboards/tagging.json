      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(cadenza_http_request_duration_seconds_bucket{histogram_schema=\"2\",job=\"cadenza-backend\",route=~\"$route\",route=~\"/tags(/.*)?|/songs/(default-tags|local-tags|activity-tags)(/.*)?\",status!=\"cancelled\"}[$__range])))",
          "legendFormat": "{{method}} {{route}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
