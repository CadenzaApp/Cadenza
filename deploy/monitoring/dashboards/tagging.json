{
  "uid": "cadenza-tagging",
  "title": "Cadenza | Tagging",
  "tags": [
    "cadenza",
    "backend",
    "feature"
  ],
  "schemaVersion": 39,
  "version": 8,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Metrics source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "cadenza-prometheus"
        }
      },
      {
        "name": "route",
        "label": "Operation route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(sort_desc(sum by (route) (increase(cadenza_http_requests_total{job=\"cadenza-backend\",route=~\"/tags(/.*)?|/songs/(default-tags|local-tags|activity-tags)(/.*)?\",status!=\"cancelled\"}[$__range]))))",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/route=\"([^\"]+)\"/",
        "sort": 0,
        "description": "Routes in this feature, busiest first over the selected time range."
      },
      {
        "name": "operation",
        "label": "Histogram operations",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "query_result(sort_desc(sum by(operation)(label_join(increase(cadenza_http_requests_total{job=\"cadenza-backend\",route=~\"$route\",route=~\"/tags(/.*)?|/songs/(default-tags|local-tags|activity-tags)(/.*)?\",status!=\"cancelled\"}[$__range]),\"operation\",\" \",\"method\",\"route\"))) > 0)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "regex": "/operation=\"([^\"]+)\"/",
        "sort": 0,
        "description": "One histogram per observed method + route; busiest first. Filter here to narrow the repeated charts."
      }
    ]
  },
  "panels": [
    {
      "id": 18,
      "type": "stat",
      "title": "Calls (range)",
      "description": "Estimated completed invocations over the selected dashboard time range; includes error responses and excludes cancelled requests, health checks and /test. Prometheus extrapolates scraped counters, so small counts can be approximate.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(cadenza_http_requests_total{job=\"cadenza-backend\",route=~\"$route\",route=~\"/tags(/.*)?|/songs/(default-tags|local-tags|activity-tags)(/.*)?\",status!=\"cancelled\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "p50 latency",
      "description": "Estimated percentile for the selected routes over the selected dashboard time range. Time until response headers. Sparse traffic yields noisy or empty estimates.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(cadenza_http_request_duration_seconds_bucket{histogram_schema=\"2\",job=\"cadenza-backend\",route=~\"$route\",route=~\"/tags(/.*)?|/songs/(default-tags|local-tags|activity-tags)(/.*)?\",status!=\"cancelled\"}[$__range])))",
          "legendFormat": "{{method}} {{route}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 latency",
      "description": "Estimated percentile for the selected routes over the selected dashboard time range. Time until response headers. Sparse traffic yields noisy or empty estimates.",
