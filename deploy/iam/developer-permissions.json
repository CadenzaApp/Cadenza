{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "autoscaling:Describe*",
        "elasticloadbalancing:Describe*",
        "ecr:Describe*",
        "ecr:ListImages",
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation",
        "ssm:ListCommands",
        "ssm:ListCommandInvocations",
        "ssm:DescribeSessions",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-west-1:175220118767:repository/cadenza-backend"
    },
    {
      "Effect": "Allow",
      "Action": [
        "autoscaling:UpdateAutoScalingGroup",
        "autoscaling:AttachLoadBalancerTargetGroups",
        "autoscaling:PutLifecycleHook",
        "autoscaling:PutNotificationConfiguration"
      ],
      "Resource": "arn:aws:autoscaling:us-west-1:175220118767:autoScalingGroup:*:autoScalingGroupName/cadenza-demo-single"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:ModifyLaunchTemplate"
      ],
      "Resource": "arn:aws:ec2:us-west-1:175220118767:launch-template/lt-0369d766012c4ef99"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-1"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress"
      ],
      "Resource": [
        "arn:aws:ec2:us-west-1:175220118767:security-group/sg-0c0e41338d7abd62a",
        "arn:aws:ec2:us-west-1:175220118767:security-group/sg-070f29b06229a834b"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "arn:aws:ec2:us-west-1:175220118767:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/CadenzaBackend": "demo"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:RegisterTargets"
      ],
      "Resource": "arn:aws:elasticloadbalancing:us-west-1:175220118767:targetgroup/cadenza-demo-single/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::175220118767:role/cadenza-demo-ec2-us-west-1",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::175220118767:role/cadenza-demo-ec2-us-west-1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies"
      ],
      "Resource": "arn:aws:iam::175220118767:role/cadenza-demo-ec2-us-west-1"
    },
    {
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:GetTopicAttributes"
      ],
      "Resource": "arn:aws:sns:us-west-1:175220118767:cadenza-demo-instance-events"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand",
        "ssm:StartSession"
      ],
      "Resource": "arn:aws:ec2:us-west-1:175220118767:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/CadenzaBackend": "demo"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": "arn:aws:ssm:us-west-1::document/AWS-RunShellScript"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession"
      ],
      "Resource": "arn:aws:ssm:us-west-1::document/AWS-StartPortForwardingSession"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": "arn:aws:ssm:us-west-1:175220118767:session/*"
    },
    {
      "Sid": "SessionManagerConsoleStatus",
      "Effect": "Allow",
      "Action": [
        "ssm:GetConnectionStatus",
        "ssm:GetServiceSetting"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-west-1"
        }
      }
    },
    {
      "Sid": "InspectBackendInstanceProfile",
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile"
      ],
      "Resource": "arn:aws:iam::175220118767:instance-profile/cadenza-demo-ec2-us-west-1"
    },
    {
      "Sid": "SessionManagerShellDocument",
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession",
        "ssm:GetDocument",
        "ssm:DescribeDocument"
      ],
      "Resource": [
        "arn:aws:ssm:us-west-1::document/SSM-SessionManagerRunShell",
        "arn:aws:ssm:us-west-1:175220118767:document/SSM-SessionManagerRunShell"
      ]
    },
    {
      "Sid": "SessionManagerDataChannel",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "arn:aws:ssm:us-west-1:175220118767:session/*"
    },
    {
      "Sid": "BrowserCliLogin",
      "Effect": "Allow",
      "Action": [
        "signin:AuthorizeOAuth2Access",
        "signin:CreateOAuth2Token"
      ],
      "Resource": "arn:aws:signin:*:175220118767:oauth2/public-client/*"
    }
  ]
}
