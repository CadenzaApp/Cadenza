# CloudFront terminates public HTTPS; host port 80 maps directly to Axum port 3000.
# Nonsecret deployed release. Use this as /opt/cadenza/release.env.
BACKEND_IMAGE=175220118767.dkr.ecr.us-west-1.amazonaws.com/cadenza-backend@sha256:8c114c88f756a462d0efc6aabcf9ddc3d5f833847803fd0a98ef9378ca832b61
# Existing local model snapshot, separate from the application's Git commit.
MODEL_REVISION=57c266a740f537b4dc058e1b0cda161fd15afa75
# Process-local limits. Counters reset on restart; days are 24-hour windows, not UTC days.
API_REQUESTS_PER_USER_MINUTE=600
TAG_REQUESTS_PER_USER_MINUTE=30
TAG_REQUESTS_PER_USER_DAY=1000
TAG_PROVIDER_CALLS_PER_DAY=7000
TAG_PROVIDER_CONCURRENCY=2
