{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "jsx": "react-native",
        "strict": true,
        "allowImportingTsExtensions": true,
        "paths": {
            "@/*": ["./src/*"],
            "@apple-musickit": ["./modules/apple-musickit/index"],
            "@image-color": ["./modules/image-color/index"]
        },
        "customConditions": [
            "react-native",
            "react-native-legacy-deep-imports"
        ],
        "types": ["node", "react"]
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "nativewind-env.d.ts",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ],
    "exclude": ["node_modules", "ios", "android"]
}
