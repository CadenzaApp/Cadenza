#!/usr/bin/env bash
# Git invokes this bootstrap; all formatting logic is shared Python code.
set -eu
root=$(git rev-parse --show-toplevel)
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    if command -v py >/dev/null 2>&1; then
      exec py -3 "$root/scripts/format.py" --check
    fi
    exec python "$root/scripts/format.py" --check
    ;;
  *) exec python3 "$root/scripts/format.py" --check ;;
esac
